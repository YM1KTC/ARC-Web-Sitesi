---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '📻 Hakkımızda - ARC YM1KTC',
};

// Statik derlenir; içerik değişince Sanity webhook'u siteyi yeniden derler.
export const prerender = true;
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="📡 Hakkımızda"
    image={{
      src: '~/assets/images/2024/12/ARC_2024_bayrak_logo-Large-1-1024x1024.png',
      alt: 'ARC Logo',
      width: 256,
      height: 256,
    }}
  >
    <Fragment slot="title">
      📻 Amatör radyo dünyasında <br />
      <span class="text-accent dark:text-white"> birlikte öğreniyoruz</span>
    </Fragment>

    <Fragment slot="subtitle">
      Amatör Radyocular Derneği (ARC), YM1KTC çağrı işaretiyle faaliyet gösteren, İstanbul merkezli kâr amacı gütmeyen
      bir dernektir. 31 Mayıs 2024 tarihinde kurulmuş olan derneğimiz, amatör telsizciliği yaygınlaştırmak, eğitim
      vermek ve röle-beacon altyapıları işletmek amacıyla faaliyet göstermektedir.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="📈 Kısaca ARC"
    stats={[
      { title: 'Kuruluş', amount: '2024' },
      { title: 'Çağrı İşareti', amount: 'YM1KTC' },
      { title: 'DMR Konuşma Grubu (TG)', amount: '28690' },
      { title: 'Merkez', amount: 'İstanbul' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="📡 Amaçlarımız ve Çalışma Alanlarımız"
    subtitle="Derneğimizin kuruluş amaçları ve bugün herkese açık olarak sunduğu kaynaklar."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: '📚 Eğitim',
        description:
          'Amatör telsizciliği öğrenmek isteyenler için ücretsiz eğitim yazıları yayımlıyor, lisans sınavına hazırlananlara sınav hazırlık uygulaması sunuyoruz.',
        icon: 'tabler:school',
        callToAction: {
          text: 'Sınav Hazırlık Sitesi',
          href: 'https://sinav.radio.org.tr/',
          target: '_blank',
        },
      },
      {
        title: '📡 Röle ve Beacon Altyapısı',
        description: 'Amatör radyocuların haberleşmesini kolaylaştıracak röle ve beacon altyapıları kurup işletmek kuruluş amaçlarımız arasında.',
        icon: 'tabler:antenna',
      },
      {
        title: '🚨 Acil Durum Haberleşmesi',
        description:
          'Amatör telsizin acil durumlarda haberleşmeye katkısını yaygınlaştırmayı ve bu konuda bilinç oluşturmayı amaçlıyoruz.',
        icon: 'tabler:phone-call',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '📶 Dijital Modlar',
        description: 'DMR, APRS ve diğer dijital modları anlatan yazılar hazırlıyor, DMR konuşma grubumuz TG 28690’da bir araya geliyoruz.',
        icon: 'tabler:device-laptop',
        callToAction: {
          text: 'DMR Kullanıcı Listesi',
          href: 'https://dmr.radio.org.tr/',
          target: '_blank',
        },
      },
      {
        title: '🔧 Teknik Projeler',
        description:
          'Üyelerimizin geliştirdiği uygulamalar, firmware ve araçlar gibi amatör radyo projelerini destekliyor ve tanıtıyoruz.',
        icon: 'tabler:tool',
        callToAction: { text: 'Blog', href: '/blog' },
      },
      {
        title: '💬 Topluluk',
        description:
          'Telegram ve WhatsApp gruplarımızda yeni başlayanlarla deneyimli operatörleri bir araya getiriyoruz.',
        icon: 'tabler:users',
        callToAction: { text: 'İletişim', href: '/iletisim' },
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="✨ Değerlerimiz"
    subtitle="Çalışmalarımızda bağlı kaldığımız ilkeler."
    items={[
      {
        title: '🎯 Herkese açık bilgi',
        description:
          'Hazırladığımız eğitim içeriklerini ve araçları ücretsiz ve üyelik şartı olmadan herkesle paylaşıyoruz.',
      },
      {
        title: '📈 Sürekli gelişim',
        description:
          'Teknolojideki gelişmeleri takip ediyor, içeriklerimizi ve araçlarımızı güncel tutmaya çalışıyoruz.',
      },
      {
        title: '🌟 Amatör radyo etiği',
        description:
          'Amatör radyo etiğini benimser; şeffaflık, dürüstlük ve toplumsal sorumluluk bilinciyle hareket ederiz.',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="💼 Yönetim Kurulu"

    columns={3}
    items={[
      {
        title: 'Cüneyt Şahna',
        description: '<strong>TA1GP</strong> · Başkan',
        icon: 'tabler:star',
        callToAction: {
          text: 'QRZ.com',
          href: 'https://www.qrz.com/db/TA1GP',
          target: '_blank',
          variant: 'link',
        },
      },
      {
        title: 'Buğra Canata',
        description: '<strong>TA1JS</strong> · Yönetim Kurulu Üyesi',
        icon: 'tabler:user',
        callToAction: {
          text: 'QRZ.com',
          href: 'https://www.qrz.com/db/TA1JS',
          target: '_blank',
          variant: 'link',
        },
      },
      {
        title: 'Fatih Önder',
        description: '<strong>TB1TFO</strong> · Yönetim Kurulu Üyesi',
        icon: 'tabler:user',
        callToAction: {
          text: 'QRZ.com',
          href: 'https://www.qrz.com/db/TB1TFO',
          target: '_blank',
          variant: 'link',
        },
      },
      {
        title: 'Muhammed Cevad Turan',
        description: '<strong>TA1XTA</strong> · Yönetim Kurulu Üyesi',
        icon: 'tabler:user',
        callToAction: {
          text: 'QRZ.com',
          href: 'https://www.qrz.com/db/TA1XTA',
          target: '_blank',
          variant: 'link',
        },
      },
      {
        title: 'Ayhan Asar',
        description: '<strong>TA2CDV</strong> · Yönetim Kurulu Üyesi',
        icon: 'tabler:user',
        callToAction: {
          text: 'QRZ.com',
          href: 'https://www.qrz.com/db/TA2CDV',
          target: '_blank',
          variant: 'link',
        },
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="🛠️ Teknik Destek"
    tagline="📡 İletişim"
    columns={2}
    items={[
      {
        title: '📮 E-posta ile iletişim',
        description: 'Teknik sorularınız, üyelik başvurunuz veya genel bilgi almak için e-posta gönderebilirsiniz.',
        icon: 'tabler:mail',
      },
      {
        title: '📞 Telefon desteği',
        description: 'Acil durumlar ve önemli konular için telefon hattımızdan bize ulaşabilirsiniz.',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
